  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DialogTrigger
  dialog:
    name: HayZeusCrust
    sentences:
    - I'm so eepy but I need to do one more thing in factorio before we go to bed.
    - You'll be fine. Here I'll give you my pistol and shotgun. Use both to defend
      yourself from the scary <i>monsters</i> (You can use the "E" key to switch
      between the two).
    - You'll be fine princess, I believe in you champ.
